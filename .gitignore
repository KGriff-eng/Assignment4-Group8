# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Environment & secrets (keep credentials out of git!)
.env
.env.*
!.env.example
*.local

# Node / JavaScript (if using Node/React/Express)
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# Python (if using Flask/Django/FastAPI/etc.)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# Keep dump files tracked if placed in dump/
!dump/*.sql
!dump/*.dump
