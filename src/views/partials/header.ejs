<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Auto Service DB</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <nav class="navbar">
      <div class="nav-brand">
        <a href="/">
          <span class="brand-dot"></span>
          <span>AutoService<span class="brand-accent">DB</span></span>
        </a>
      </div>
      <ul class="nav-links">
        <li><a href="/">Dashboard</a></li>
        <li><a href="/features/option1">Option 1</a></li>
        <li><a href="/features/option2">Option 2</a></li>
        <li><a href="/features/option3">Option 3</a></li>
        <li><a href="/features/option4">Option 4</a></li>
        <li><a href="/features/option5">Supplier Lookup</a></li>
        <li><a href="/features/option6">Service History</a></li>
        <li><a href="/features/option7">Customer Lookup</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><strong>Error:</strong> <%= error %></div>
    <% } %>