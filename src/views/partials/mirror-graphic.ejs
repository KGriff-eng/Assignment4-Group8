
<svg class="registry-graphic"
     viewBox="0 0 330 240"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="true">

    <defs>

        <linearGradient id="mirrorChrome"
                        x1="0%" y1="0%"
                        x2="30%" y2="100%">
            <stop offset="0%" stop-color="#fff4ec"/>
            <stop offset="35%" stop-color="#94879c"/>
            <stop offset="55%" stop-color="#e6d9e7"/>
            <stop offset="100%" stop-color="#6f657f"/>
        </linearGradient>

        <linearGradient id="mirrorSunset"
                        x1="0%" y1="0%"
                        x2="0%" y2="100%">
            <stop offset="0%" stop-color="#c8c5df"/>
            <stop offset="55%" stop-color="#e6c6ce"/>
            <stop offset="100%" stop-color="#e5b1a3"/>
        </linearGradient>

        <clipPath id="mirrorReflection">
            <rect x="-126" y="-42"
                  width="252" height="84" rx="29"/>
        </clipPath>

    </defs>

    <!-- Vintage rear-view mirror -->

    <g transform="translate(165 78) rotate(-7)">

        <!-- Mirror mounting bracket -->
        <path d="M0 -48 V-72"
              stroke="#451616"
              stroke-width="13"
              stroke-linecap="round"/>

        <path d="M0 -48 V-72"
              stroke="url(#mirrorChrome)"
              stroke-width="8"
              stroke-linecap="round"/>

        <!-- Shadow -->
        <rect x="-140" y="-53"
              width="280" height="106" rx="38"
              fill="#451616" opacity="0.15"
              transform="translate(4 6)"/>

        <!-- Chrome frame -->
        <rect x="-140" y="-53"
              width="280" height="106" rx="38"
              fill="url(#mirrorChrome)"
              stroke="#451616" stroke-width="1.5"/>

        <rect x="-132" y="-47"
              width="264" height="94" rx="33"
              fill="#200808"/>

        <rect x="-126" y="-42"
              width="252" height="84" rx="29"
              fill="url(#mirrorSunset)"/>

        <!-- Sunset and road reflection -->
        <g clip-path="url(#mirrorReflection)">

            <circle cx="68" cy="-7" r="23"
                    fill="#f8d6b9"/>

            <!-- Distant mountains -->
            <path d="M-130 25
                     L-82 -13
                     L-42 12
                     L-3 -24
                     L44 14
                     L93 -9
                     L130 23
                     V45 H-130 Z"
                  fill="#817b9b"/>

            <!-- Foreground landscape -->
            <path d="M-130 34
                     L-57 11
                     L-15 26
                     L39 12
                     L130 32
                     V48 H-130 Z"
                  fill="#514056"/>

            <!-- Open road -->
            <path d="M-44 45
                     L-8 14
                     H7
                     L54 45 Z"
                  fill="#451616"/>

            <!-- Road markings -->
            <path d="M6 41 L1 30
                     M-2 25 L-4 19"
                  stroke="#f4d9cb"
                  stroke-width="2"/>

            <!-- Glass reflection -->
            <path d="M-100 -42
                     H-40
                     L-92 42
                     H-140 Z"
                  fill="#ffffff"
                  opacity="0.13"/>

        </g>

        <!-- Mirror adjustment tab -->
        <path d="M-15 54 H15 L10 62 H-10 Z"
              fill="#451616"/>

    </g>

    <!-- Hanging key tag cord -->
    <path d="M160 128
             Q138 150 169 173"
          fill="none"
          stroke="#451616"
          stroke-width="2.5"/>

    <!-- Vintage workshop key tag -->
    <g transform="translate(176 185) rotate(13)">

        <path d="M-28 -31
                 L-40 -13
                 L-30 37
                 H30
                 L40 -13
                 L28 -31 Z"
              fill="#451616"
              opacity="0.15"
              transform="translate(4 4)"/>

        <path d="M-28 -31
                 L-40 -13
                 L-30 37
                 H30
                 L40 -13
                 L28 -31 Z"
              fill="#451616"
              stroke="#dbbddc"
              stroke-width="2"/>

        <circle cy="-20" r="4"
                fill="#dbbddc"/>

        <path d="M-28 -7 H28
                 M-25 24 H25"
              stroke="#f47358"
              stroke-width="1.5"/>

        <text y="5"
              font-size="8"
              fill="#dbbddc"
              text-anchor="middle"
              letter-spacing="1.5">
            AUTO SERVICE
        </text>

        <text y="19"
              font-size="15"
              font-family="Georgia"
              font-weight="bold"
              fill="#dbbddc"
              text-anchor="middle">
            No. 07
        </text>

    </g>

</svg>
